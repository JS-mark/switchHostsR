{
  "name": "switch-hosts-r",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": {
    "name": "The Mark",
    "email": "sunduo3195@qq.com"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "naive-ui",
    "vue3",
    "ts",
    "tsx",
    "typescript"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "dev:tauri": "vite --mode tauri",
    "dev:utool": "vite --mode utool",
    "preview": "vite preview",
    "remote:server": "vite-node ./src/mock/index.ts",
    "build:tauri": "vue-tsc --noEmit && vite build --mode tauri",
    "build:utool": "vue-tsc --noEmit && vite build --mode utool",
    "docs:dev": "rspress dev docs",
    "docs:build": "rspress build docs",
    "docs:preview": "rspress preview docs",
    "deploy": "gh-pages -d dist",
    "lint:eslint": "eslint \"{src,mock}/**/*.{vue,ts,tsx}\" --fix",
    "lint:stylelint": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/"
  },
  "dependencies": {
    "@alova/mock": "^2.0.17",
    "@monaco-editor/loader": "^1.7.0",
    "@octokit/core": "^7.0.6",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-fs": "~2.4.4",
    "@tauri-apps/plugin-global-shortcut": "~2.3.1",
    "@tauri-apps/plugin-http": "~2.5.4",

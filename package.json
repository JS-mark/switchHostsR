{
  "name": "switch-hosts-r",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": {
    "name": "The Mark",
    "email": "sunduo3195@qq.com"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "naive-ui",
    "vue3",
    "ts",
    "tsx",
    "typescript"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "dev:tauri": "vite --mode tauri",
    "dev:utool": "vite --mode utool",
    "preview": "vite preview",
    "remote:server": "vite-node ./src/mock/index.ts",
    "build:tauri": "vue-tsc --noEmit && vite build --mode tauri",
    "build:utool": "vue-tsc --noEmit && vite build --mode utool",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy": "gh-pages -d dist",
    "lint:eslint": "eslint \"{src,mock}/**/*.{vue,ts,tsx}\" --fix",
    "lint:stylelint": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/"
  },
  "dependencies": {
    "@alova/mock": "^2.0.9",
    "@monaco-editor/loader": "^1.4.0",
    "@octokit/core": "^6.1.2",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-global-shortcut": "~2",
    "@tauri-apps/plugin-http": "~2",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-os": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-shell": "~2",
    "@vicons/antd": "^0.12.0",
    "@vicons/ionicons5": "^0.12.0",
    "@vueuse/core": "^11.2.0",
    "alova": "^3.2.3",
    "dayjs": "^1.11.13",
    "element-resize-detector": "^1.2.4",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "mockjs": "^1.1.0",
    "monaco-editor": "^0.52.0",
    "naive-ui": "^2.40.1",
    "nanoid": "^5.0.8",
    "pinia": "^2.2.6",
    "pinia-plugin-persist": "^1.0.0",
    "qs": "^6.13.0",
    "stylus": "^0.64.0",
    "vfonts": "^0.0.3",
    "vue": "^3.5.12",
    "vue-i18n": "^10.0.4 ",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.8.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@faker-js/faker": "^9.1.0",
    "@intlify/unplugin-vue-i18n": "^5.2.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/json-server": "^0.14.7",
    "@types/lodash": "^4.17.12",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.8.7",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vue/compiler-sfc": "^3.5.12",
    "autoprefixer": "^10.4.20",
    "commitizen": "^4.3.1",
    "dotenv": "^16.4.5",
    "eslint": "^9.14.0",
    "fs-extra": "^11.2.0",
    "husky": "^9.1.6",
    "less": "^4.2.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "simple-git-hooks": "^2.11.1",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-scss": "^6.8.1",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "utools-api-types": "^5.2.0",
    "vite": "^5.4.10",
    "vite-node": "^2.1.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-windicss": "^1.9.3",
    "vite-svg-loader": "^5.1.0",
    "vitepress": "^1.5.0",
    "vue-demi": "^0.14.10",
    "vue-tsc": "^2.1.10",
    "windicss": "^3.5.6"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{vue,js,ts,tsx}": "eslint --fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
}

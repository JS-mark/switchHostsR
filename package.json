    "@vicons/ionicons5": "^0.13.0",
    "@vicons/tabler": "^0.13.0",
    "@vueuse/core": "^14.1.0",
    "alova": "^3.4.0",
    "dayjs": "^1.11.19",
    "element-resize-detector": "^1.2.4",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "naive-ui": "^2.43.2",
    "nanoid": "^5.1.6",
    "pinia": "^3.0.4",

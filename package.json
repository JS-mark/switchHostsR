{
  "name": "switch-hosts-r",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": {
    "name": "The Mark",
    "email": "sunduo3195@qq.com"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "naive-ui",
    "vue3",
    "ts",
    "tsx",
    "typescript"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "dev:tauri": "vite --mode tauri",
    "dev:utool": "vite --mode utool",
    "preview": "vite preview",
    "remote:server": "vite-node ./src/mock/index.ts",
    "build:tauri": "vue-tsc --noEmit && vite build --mode tauri",
    "build:utool": "vue-tsc --noEmit && vite build --mode utool",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy": "gh-pages -d dist",
    "lint:eslint": "eslint \"{src,mock}/**/*.{vue,ts,tsx}\" --fix",
    "lint:stylelint": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/"
  },
  "dependencies": {
    "@alova/mock": "^2.0.14",
    "@monaco-editor/loader": "^1.5.0",
    "@octokit/core": "^6.1.5",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.2",
    "@tauri-apps/plugin-dialog": "~2.2.1",
    "@tauri-apps/plugin-fs": "~2.2.1",
    "@tauri-apps/plugin-global-shortcut": "~2.2.0",
    "@tauri-apps/plugin-http": "~2.2.0",
    "@tauri-apps/plugin-notification": "~2.2.2",
    "@tauri-apps/plugin-os": "~2.2.1",
    "@tauri-apps/plugin-process": "~2.2.1",
    "@tauri-apps/plugin-shell": "~2.2.1",
    "@unocss/reset": "^66.1.0-beta.12",
    "@vicons/antd": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^13.1.0",
    "alova": "^3.2.10",
    "dayjs": "^1.11.13",
    "element-resize-detector": "^1.2.4",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.52.2",
    "naive-ui": "^2.41.0",
    "nanoid": "^5.1.5",
    "pinia": "^3.0.2",
    "qs": "^6.14.0",
    "stylus": "^0.64.0",
    "vfonts": "^0.0.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@faker-js/faker": "^9.7.0",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@tauri-apps/cli": "^2.5.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue/compiler-sfc": "^3.5.13",
    "autoprefixer": "^10.4.21",
    "commitizen": "^4.3.1",
    "dotenv": "^16.5.0",
    "eslint": "^9.25.1",
    "fs-extra": "^11.3.0",
    "husky": "^9.1.7",
    "less": "^4.3.0",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.3",
    "simple-git-hooks": "^2.12.1",
    "typescript": "^5.8.2",
    "unocss": "^66.1.0-beta.12",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.4.1",
    "utools-api-types": "^7.0.0",
    "vite": "^6.2.4",
    "vite-node": "^3.1.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-svg-loader": "^5.1.0",
    "vitepress": "^1.6.3",
    "vue-tsc": "^2.2.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{vue,js,ts,tsx}": "eslint --fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
